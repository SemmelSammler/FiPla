# ACHTUNG: js/seed.js enthält aus der Original-Excel abgeleitete Beispieldaten
# (echte Empfänger/Beträge/eine Vertragskontonummer). Dieses Repository darf
# deshalb NIEMALS öffentlich gestellt werden, ohne seed.js vorher durch rein
# synthetische Daten zu ersetzen.

# Abhängigkeiten & Build-Ausgaben (werden aus dem Quellcode erzeugt)
node_modules/
dist/
src-tauri/target/

# macOS-Kram
.DS_Store

# lokale Versand-/Arbeitsdateien
Archiv.zip
*.zip

# ECHTE Finanzdaten des Nutzers — dürfen niemals ins Repo.
# Enthalten Kontostände, Empfänger und Buchungen.
daten/

# gh-Kommandozeile als 37-MB-Einzeldatei — Werkzeug, kein Quellcode.
# tools/serve.js bleibt dagegen versioniert, das gehört zum Arbeitsablauf.
tools/gh

# sitzungsbezogene Berechtigungen (Claude Code)
.claude/settings.local.json

# Gebaute BoSal-Entwürfe enthalten seed.js-Daten
entwurf/*.html
