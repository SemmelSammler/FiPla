{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Finanzplanung",
  "version": "0.1.0",
  "identifier": "de.finanzplanung.desktop",
  "build": {
    "frontendDist": "../dist/native",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Finanzplanung",
        "width": 1440,
        "height": 900,
        "minWidth": 700,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["bin/touchid-helper"],
    "fileAssociations": [
      { "ext": ["csv"], "description": "CSV-Kontoauszug", "role": "Viewer" },
      { "ext": ["tsv"], "description": "TSV-Kontoauszug", "role": "Viewer" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
