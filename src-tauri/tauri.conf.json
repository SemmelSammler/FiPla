{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Obol",
  "version": "0.2.0",
  "identifier": "de.obol.app",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node bosal/build.cjs",
    "beforeBuildCommand": "node bosal/build.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Obol",
        "width": 1360,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "bin/touchid-helper"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
